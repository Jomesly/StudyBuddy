{
  "name": "studybuddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/setup-models.mjs && node scripts/build-worker.mjs",
    "models": "node scripts/setup-models.mjs",
    "predev": "node scripts/build-worker.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "build": "node scripts/setup-models.mjs && node scripts/build-worker.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s tests/python -v",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.32"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "vite": "8.3.5"
  }
}
